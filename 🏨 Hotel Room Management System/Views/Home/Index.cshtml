@{
    ViewData["Title"] = "Home Page";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    .hrms-home {
        --ink: #12192B;
        --brass: #C6A15B;
        --brass-light: #E7CC8B;
        --paper: #FBF8F1;
        --muted: #9AA3BE;
        --ink-muted: #5B6072;
        --line: rgba(198, 161, 91, .35);
        font-family: 'Inter', sans-serif;
        color: var(--ink);
    }

    .hrms-hero {
        background: radial-gradient(120% 140% at 15% 20%, #1C2748 0%, var(--ink) 65%);
        border-radius: 1.25rem;
        padding: 4.5rem 3rem;
        color: var(--paper);
        position: relative;
        overflow: hidden;
    }

    .hrms-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, var(--brass) 1px, transparent 1px);
        background-size: 26px 26px;
        opacity: .08;
        pointer-events: none;
    }

    .hrms-eyebrow {
        font: 600 .75rem/1 'Inter', sans-serif;
        letter-spacing: .22em;
        text-transform: uppercase;
        color: var(--brass-light);
        display: inline-block;
        margin-bottom: 1.25rem;
    }

    .hrms-hero h1 {
        font-family: 'Fraunces', serif;
        font-weight: 500;
        font-style: italic;
        font-size: clamp(2.2rem, 5vw, 3.75rem);
        line-height: 1.08;
        margin-bottom: 1rem;
        position: relative;
    }

    .hrms-hero p {
        color: var(--muted);
        font-size: 1.05rem;
        max-width: 32rem;
        margin-bottom: 0;
        position: relative;
    }

    .hrms-section-label {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 3.5rem 0 2.25rem;
    }

    .hrms-section-label span {
        font: 600 .75rem/1 'Inter', sans-serif;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--ink-muted);
        white-space: nowrap;
    }

    .hrms-section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--line);
    }

    .hrms-tags {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2.75rem 2rem;
    }

    .hrms-tag {
        position: relative;
        padding-top: 2rem;
    }

    .hrms-tag::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 1px;
        height: 1.25rem;
        background: var(--line);
    }

    .hrms-tag::after {
        content: '';
        position: absolute;
        top: 1.1rem;
        left: 50%;
        transform: translateX(-50%);
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: var(--paper);
        border: 2.5px solid var(--brass);
    }

    .hrms-tag-card {
        background: var(--paper);
        border: 1px solid rgba(198, 161, 91, .3);
        border-radius: .9rem;
        padding: 2rem 1.75rem;
        height: 100%;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

    .hrms-tag-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px -22px rgba(18, 25, 43, .4);
        border-color: var(--brass);
    }

    .hrms-tag-icon {
        width: 2.5rem;
        height: 2.5rem;
        color: var(--brass);
        margin-bottom: 1.25rem;
    }

    .hrms-tag-card h3 {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.35rem;
        margin-bottom: .5rem;
        color: var(--ink);
    }

    .hrms-tag-card p {
        color: var(--ink-muted);
        font-size: .925rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .hrms-tag-link {
        font-weight: 600;
        font-size: .875rem;
        color: var(--ink);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

    .hrms-tag-link:hover {
        color: var(--brass);
    }

    .hrms-tag-link svg {
        width: 1rem;
        height: 1rem;
        transition: transform .2s ease;
    }

    .hrms-tag-link:hover svg {
        transform: translateX(3px);
    }

    .hrms-footer {
        text-align: center;
        padding: 2.5rem 0 .5rem;
        color: var(--ink-muted);
        font-size: .85rem;
        border-top: 1px solid var(--line);
        margin-top: 3.5rem;
    }

    .hrms-footer .brass-dot {
        color: var(--brass);
    }

    @@media (max-width: 767px) {
        .hrms-tags {
            grid-template-columns: 1fr;
        }

        .hrms-hero {
            padding: 3rem 1.5rem;
        }
    }
</style>

<div class="hrms-home">

    <section class="hrms-hero">
        <span class="hrms-eyebrow">Front Desk Dashboard</span>
        <h1>Good day at the desk.</h1>
        <p>Manage rooms, track bookings, and keep guest records straight — everything the front desk needs, in one place.</p>
    </section>

    <div class="hrms-section-label">
        <span>Manage the Property</span>
    </div>

    <div class="hrms-tags">

        <div class="hrms-tag">
            <div class="hrms-tag-card">
                <svg class="hrms-tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3>Rooms</h3>
                <p>See every room's status at a glance and update details as they change.</p>
                <a asp-controller="Rooms" asp-action="Index" class="hrms-tag-link">
                    Open Rooms
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="hrms-tag">
            <div class="hrms-tag-card">
                <svg class="hrms-tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M8 2v4M16 2v4M3 9h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3>Bookings</h3>
                <p>Check guests in and out, and keep every stay on schedule.</p>
                <a asp-controller="Bookings" asp-action="Index" class="hrms-tag-link">
                    Open Bookings
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="hrms-tag">
            <div class="hrms-tag-card">
                <svg class="hrms-tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke-linecap="round" />
                </svg>
                <h3>Customers</h3>
                <p>Keep guest details on hand for faster, smoother check-ins next time.</p>
                <a asp-controller="Customers" asp-action="Index" class="hrms-tag-link">
                    Open Customers
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
        </div>

    </div>

    <footer class="hrms-footer">
        <span class="brass-dot">●</span> Hotel Room Management System
    </footer>

</div>
