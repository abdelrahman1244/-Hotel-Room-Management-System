@model Room

<style>
    .hrms-room-details-wrap {
        max-width: 900px;
        margin: 0 auto;
    }

        .hrms-room-details-wrap h1 {
            font-family: 'Fraunces', serif;
            font-style: italic;
            font-weight: 500;
            color: #12192B;
        }

    .hrms-room-details-card {
        background: #FBF8F1;
        border: 1px solid rgba(198, 161, 91, .3);
        border-radius: .9rem;
    }

    .hrms-room-details-table {
        border: 1px solid rgba(198, 161, 91, .3);
    }

        .hrms-room-details-table thead th {
            background: #12192B !important;
            color: #FBF8F1 !important;
            font-weight: 600;
            font-size: .85rem;
            letter-spacing: .04em;
            text-transform: uppercase;
            border-color: #12192B !important;
        }

        .hrms-room-details-table td,
        .hrms-room-details-table th {
            border-color: rgba(198, 161, 91, .3);
            vertical-align: middle;
        }

    .hrms-price {
        font-weight: 600;
        color: #12192B;
    }

    .hrms-btn-delete {
        background: #B23A48;
        border-color: #B23A48;
        color: #FBF8F1;
        font-weight: 600;
    }

        .hrms-btn-delete:hover {
            background: #8F2E39;
            border-color: #8F2E39;
            color: #FBF8F1;
        }

    .hrms-btn-back {
        background: transparent;
        border-color: #12192B;
        color: #12192B;
        font-weight: 600;
    }

        .hrms-btn-back:hover {
            background: #12192B;
            border-color: #12192B;
            color: #FBF8F1;
        }
</style>


<div class="hrms-room-details-wrap">

    <h1 class="text-center mb-4">
       Delete Room 
    </h1>

    <div class="card shadow p-4 hrms-room-details-card">

        <div class="table-responsive">

            <table class="table table-bordered table-hover text-center align-middle mb-0 hrms-room-details-table">

                <thead>
                    <tr>
                        <th>Room ID</th>
                        <th>Room Number</th>
                        <th>Type</th>
                        <th>Price Per Night</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>@Model.Id</td>

                        <td>
                            @Model.RoomNumber
                        </td>

                        <td>
                            @Model.Type
                        </td>

                        <td class="hrms-price">
                            @Model.PricePerNight.ToString("C")
                        </td>
                    </tr>
                </tbody>

            </table>

        </div>

        <div class="d-flex justify-content-center gap-2 mt-4">

            <form method="post"
                  asp-controller="Rooms"
                  asp-action="Delete">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn hrms-btn-delete">
                    Confirm Delete
                </button>

            </form>

            <a asp-controller="Rooms"
               asp-action="Index"
               class="btn hrms-btn-back">
                Back
            </a>

        </div>

    </div>

</div>